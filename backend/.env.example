# ---------- Server ----------
# Set to "production" on the live server. The server then REFUSES TO START if
# anything is unsafe (default admin password, short JWT_SECRET, CUSTOMER_OTP_DEV=true,
# missing WA_CLOUD_APP_SECRET, CORS_ORIGINS pointing at localhost).
NODE_ENV=development
# Number of proxies in front of this server (e.g. 1 when behind Nginx).
# Leave false when there is no proxy, otherwise anyone can fake their IP address
# and get around the login and booking limits.
TRUST_PROXY=false
PORT=4000
# Comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:4200
# Time zone used for slots, reminders and "today"
APP_TIMEZONE=Asia/Kolkata
# SQLite database file (created automatically)
DB_FILE=./data/app.db

# ---------- Admin (created on first start only) ----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe@123
# Long random string (32+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# ---------- Business ----------
BUSINESS_NAME=CoolCare Home Services
# WhatsApp number of the business (country code + number, digits only)
BUSINESS_WHATSAPP=919876543210
DEFAULT_COUNTRY_CODE=91

# ---------- WhatsApp follow-up ----------
# none   -> messages are logged; admin sends them with one click (wa.me link)
# cloud  -> Meta WhatsApp Cloud API (automatic)
# twilio -> Twilio WhatsApp API (automatic)
WHATSAPP_PROVIDER=none

# Meta WhatsApp Cloud API
WA_CLOUD_TOKEN=
WA_CLOUD_PHONE_NUMBER_ID=
WA_CLOUD_API_VERSION=v21.0
# Meta only allows free-text messages inside the 24h customer window.
# For business-initiated messages set this to true and create an approved
# template with ONE body variable {{1}}; the message text is passed into it.
WA_CLOUD_USE_TEMPLATE=false
WA_CLOUD_TEMPLATE_NAME=service_update
WA_CLOUD_TEMPLATE_LANG=en

# Webhook for customer WhatsApp OTP login (Cloud API only).
# Meta dashboard -> WhatsApp -> Configuration -> Webhook:
#   Callback URL: https://<your-domain>/api/whatsapp/webhook   Verify token: WA_CLOUD_VERIFY_TOKEN
#   Subscribe to the "messages" field.
WA_CLOUD_VERIFY_TOKEN=
# Meta app -> App settings -> Basic -> App secret (used to check webhook signatures)
WA_CLOUD_APP_SECRET=

# ---------- Customer login ----------
# Google sign-in: OAuth 2.0 Client ID (type "Web application") from
# https://console.cloud.google.com/apis/credentials
# Add your site to "Authorized JavaScript origins", e.g. http://localhost:4200 and https://yourdomain.com
GOOGLE_CLIENT_ID=
# LOCAL TESTING ONLY: show the login code on screen instead of sending it on WhatsApp.
# Used only when WHATSAPP_PROVIDER is not "cloud". Never set this to true on a live site.
CUSTOMER_OTP_DEV=false

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=
