# ---------- Server ----------
# Set to "production" on the live server. The server then REFUSES TO START if
# anything is unsafe (default admin password, short JWT_SECRET, CUSTOMER_OTP_DEV=true,
# missing WA_CLOUD_APP_SECRET, CORS_ORIGINS pointing at localhost).
NODE_ENV=development
# Number of proxies in front of this server (e.g. 1 when behind Nginx).
# Leave false when there is no proxy, otherwise anyone can fake their IP address
# and get around the login and booking limits.
TRUST_PROXY=false
PORT=4000
# Comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:4200
# Time zone used for slots, reminders and "today"
APP_TIMEZONE=Asia/Kolkata
# ---------- Database ----------
# Option 1 (live server, recommended on Hostinger): MySQL.
# Create it in hPanel -> Databases -> MySQL Databases, then fill these in.
# When DB_HOST is set, MySQL is used and DB_FILE is ignored. Tables are created automatically.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# Optional: MySQL socket file. Leave empty: with DB_HOST=localhost the usual locations are tried.
DB_SOCKET=
# Option 2 (local development): SQLite file, created automatically.
# Used only when DB_HOST is empty. On a live server keep it OUTSIDE the app folder,
# because every redeploy replaces the app folder (default there: ~/moonfix-data/app.db).
DB_FILE=./data/app.db

# ---------- Admin (created on first start only) ----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe@123
# Long random string (32+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# ---------- Business ----------
BUSINESS_NAME=CoolCare Home Services
# WhatsApp number of the business (country code + number, digits only)
BUSINESS_WHATSAPP=919876543210
DEFAULT_COUNTRY_CODE=91

# ---------- WhatsApp follow-up ----------
# none   -> messages are logged; admin sends them with one click (wa.me link)
# cloud  -> Meta WhatsApp Cloud API (automatic)
# twilio -> Twilio WhatsApp API (automatic)
WHATSAPP_PROVIDER=none

# Meta WhatsApp Cloud API - full step-by-step guide: WHATSAPP_SETUP.md
# Permanent token of a System User (Business settings > Users > System users) with
# whatsapp_business_messaging + whatsapp_business_management permissions. Keep it secret.
WA_CLOUD_TOKEN=
# WhatsApp > API Setup in the Meta app: "Phone number ID" and "WhatsApp Business Account ID"
WA_CLOUD_PHONE_NUMBER_ID=
WA_CLOUD_WABA_ID=
WA_CLOUD_API_VERSION=v21.0
# Every automatic message uses its own approved template (texts in src/waTemplates.js).
# Submit them all to Meta with:  npm run wa:templates -- --create   (check with --status)
WA_CLOUD_TEMPLATE_LANG=en

# Webhook: delivery receipts (delivered / read / failed), customer replies and WhatsApp OTP login.
# Meta app -> WhatsApp -> Configuration -> Webhook:
#   Callback URL: https://<your-domain>/api/whatsapp/webhook   Verify token: WA_CLOUD_VERIFY_TOKEN
#   Subscribe to the "messages" field.
WA_CLOUD_VERIFY_TOKEN=
# Meta app -> App settings -> Basic -> App secret (used to check webhook signatures)
WA_CLOUD_APP_SECRET=

# ---------- Customer login ----------
# Google sign-in: OAuth 2.0 Client ID (type "Web application") from
# https://console.cloud.google.com/apis/credentials
# Add your site to "Authorized JavaScript origins", e.g. http://localhost:4200 and https://yourdomain.com
GOOGLE_CLIENT_ID=
# LOCAL TESTING ONLY: show the login code on screen instead of sending it on WhatsApp.
# Used only when WHATSAPP_PROVIDER is not "cloud". Never set this to true on a live site.
CUSTOMER_OTP_DEV=false

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=
